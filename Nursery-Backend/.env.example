# ==========================================
# GreenBeli Nursery Backend - Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR REAL CREDENTIALS
# DO NOT COMMIT .env TO VERSION CONTROL
# ==========================================

# Server
PORT=5007
NODE_ENV=development

# Database
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGO_DB_NAME=Greenbeli-DB

# Supabase Auth & Storage
SUPABASE_URL=https://<your-project-id>.supabase.co
SUPABASE_ANON_KEY=replace_with_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_secret_key
SUPABASE_BUCKET=Greenbeli-Images

# Email Services
RESEND_API_KEY=re_replace_with_your_resend_api_key
RESEND_FROM_EMAIL=support@greenbeli.in

# SMTP (Gmail / Custom SMTP)
SMTP_NAME=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password

# Client URLs (for CORS & Redirection)
SITE_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5174
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174,https://greenbeli.in,https://admin.greenbeli.in
COOKIE_DOMAIN=localhost

